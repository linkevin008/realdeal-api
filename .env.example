PORT=8080
ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=realdeal
DB_PASSWORD=your_password_here
DB_NAME=realdeal_core
DB_SSL_MODE=disable

JWT_SECRET=use-a-long-random-string

# Hours a buyer has to pay after an offer is accepted before the seller can
# report non-payment (internal/handlers/trust.go).
PAYMENT_DEADLINE_HOURS=72

# Days a contract has to reach executed (both parties signed) after it's
# created on offer acceptance, before it lazily expires and the property
# reverts to active (internal/models/contract.go).
CONTRACT_EXECUTION_DEADLINE_DAYS=14

AWS_REGION=us-west-2
# Local development points the AWS SDK at LocalStack (docker compose up -d).
# In production these are unset/real: no endpoint override, credentials from the
# ECS task role, real bucket + CloudFront domain.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=realdeal-media-local
CLOUDFRONT_BASE_URL=http://localhost:4566/realdeal-media-local
